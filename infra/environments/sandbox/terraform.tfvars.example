aws_account_id = "123456789012"
aws_region     = "ca-central-1"
bootstrap_admin_role_arns = ["arn:aws:iam::123456789012:role/LabAdministrator"]

# Initial apply leaves SAML disabled. Export live metadata, then enable:
# saml_metadata_path = "../../../identity/generated/metadata.xml"
# Reuse existing account-global issuer if already configured:
# existing_github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
enable_operations_host = true
